     "items": [{"title": "入睡期 N1", "text": "几分钟，容易被叫醒"}, {"title": "浅睡期 N2", "text": "占一晚的一半左右"}, {"title": "深睡期 N3", "text": "身体修复，前半夜多"}, {"title": "快速眼动 REM", "text": "做梦，后半夜多"}]},
    {"type": "draw", "title": "典型的一晚：深睡在前，做梦在后", "note": "教科书模式图，不是个人数据", "height": 230,
     "js": "const C=new PK.Chart(w,230),L=['清醒','REM','N1','N2','N3'],st=[0,2,3,4,3,2,1,3,4,3,1,3,3,1,2,3,1,0],X=i=>70+i*(w-80)/(st.length-1),Y=k=>20+k*42;L.forEach((t,k)=>{C.svg(`<line x1='70' x2='${w-10}' y1='${Y(k)}' y2='${Y(k)}' stroke='#eef0f4' stroke-width='1.5'/>`);C.text(56,Y(k),t,'ax','r','m')});let d='';st.forEach((k,i)=>{d+=(i?`H${X(i)}V${Y(k)}`:`M${X(0)},${Y(k)}`)});C.svg(`<path d='${d}' fill='none' stroke='${PK.ACC}' stroke-width='4' stroke-linejoin='round'/>`);st.forEach((k,i)=>{if(k===1)C.svg(`<rect x='${X(i)-2}' y='${Y(1)-7}' width='${X(i+1)-X(i)+4}' height='14' rx='7' fill='${PK.mix(PK.ACC,PK.W,.55)}'/>`)});['23:00','01:00','03:00','05:00','07:00'].forEach((t,i)=>C.text(70+i*(w-80)/4,Y(4)+22,t,'ax','c','t'));C.done(el)"},
    {"type": "timeline", "title": "睡前时间表", "layout": "horizontal", "items": [
      {"time": "睡前 6 小时", "title": "最后一杯咖啡", "icon": "coffee"},
      {"time": "睡前 3 小时", "title": "吃完晚饭", "icon": "utensils"},
      {"time": "睡前 1 小时", "title": "调暗灯光", "icon": "lamp"},
      {"time": "上床", "title": "手机放远一点", "icon": "moon", "highlight": true}]},
    {"type": "steps", "title": "躺了 20 分钟还睡不着？", "items": [
      {"title": "起床", "text": "离开卧室，别在床上硬躺"}, {"title": "做点安静的事", "text": "暗光下看书、听舒缓的音乐"},
      {"title": "困了再回床", "text": "让床只和睡觉联系在一起"}, {"title": "第二天照常起", "text": "不补觉，节律才能稳住"}]},
    {"type": "compare", "title": "周末补觉 vs 规律作息", "left": {"title": "周末补觉", "icon": "bed", "tone": "gray"}, "right": {"title": "规律作息", "icon": "calendar-check"},
     "rows": [{"label": "周一早上", "left": "像倒时差", "right": "照常清醒", "winner": "right"}, {"label": "生物钟", "left": "被来回拉扯", "right": "稳定", "winner": "right"},
              {"label": "周末多睡", "left": "当下很爽", "right": "差别不大", "winner": "left"}]},
