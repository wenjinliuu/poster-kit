{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wenjinliuu/poster-kit/skill/pastel-poster/references/spec.schema.json",
  "title": "pastel-poster spec",
  "description": "海报 spec.json 的结构。字段含义见 sections.md；更细的检查（引用的公司是否登记、标题字数等）由 scripts/validate_spec.py 做。",
  "type": "object",
  "required": ["title", "sections", "footer"],
  "properties": {
    "file": {"type": "string", "description": "下载文件名前缀"},
    "eyebrow": {"type": "string", "description": "标题上方小字"},
    "tag": {"type": "string", "description": "眉题旁的描边小标签"},
    "title": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 3, "description": "[黑色主句, 强调色大字, 灰色副句]"},
    "object": {"enum": ["chip", "module", "rack", "coin", "globe"], "description": "右上角背景物件"},
    "accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "强调色，默认靛紫 #5b4cff"},
    "updown": {"enum": ["cn", "us"], "description": "cn 红涨绿跌（默认），us 绿涨红跌"},
    "versions": {"type": "array", "items": {"type": "string"}},
    "companies": {
      "type": "object",
      "description": "键写 交易所:代码、Yahoo 后缀代码或 市场:代码",
      "additionalProperties": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "code": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "footer": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "page_title": {"type": "string"},
    "page_sub": {"type": "string"},
    "mark": {"type": "string"},
    "mark_sub": {"type": "string"}
  },
  "$defs": {
    "label": {"oneOf": [{"type": "string"}, {"type": "object", "properties": {"label": {"type": "string"}, "sub": {"type": "string"}}, "required": ["label"]}]},
    "section": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["chain", "kpis", "holdings", "years", "ranking", "banner", "flows", "table", "notes", "html"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "chain"}}}, "then": {"required": ["groups"], "properties": {
          "cols": {"type": "integer", "minimum": 2, "maximum": 6},
          "groups": {"type": "array", "maxItems": 8, "items": {"type": "object", "required": ["name", "companies"], "properties": {
            "name": {"type": "string"}, "desc": {"type": "string"}, "icon": {"type": "string"},
            "companies": {"type": "array", "items": {"type": "string"}}}}}}}},
        {"if": {"properties": {"type": {"const": "kpis"}}}, "then": {"required": ["items"], "properties": {
          "items": {"type": "array", "maxItems": 4, "items": {"type": "object", "required": ["label", "value"], "properties": {
            "label": {"type": "string"}, "value": {"type": ["string", "number"]}, "unit": {"type": "string"}, "note": {"type": "string"}, "tone": {"enum": ["up", "down"]}}}}}}},
        {"if": {"properties": {"type": {"const": "holdings"}}}, "then": {"required": ["items"], "properties": {
          "items": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "number"}]}},
          "other": {"type": "number"}, "center_label": {"type": "string"}, "center_value": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "years"}}}, "then": {"required": ["items"], "properties": {
          "items": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "number"}]}},
          "highlight_last": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"const": "ranking"}}}, "then": {"required": ["items"], "properties": {
          "items": {"type": "array", "items": {"type": "array", "prefixItems": [{"$ref": "#/$defs/label"}, {"type": "number"}]}},
          "unit": {"type": "string"}, "other": {"type": "array"}}}},
        {"if": {"properties": {"type": {"const": "banner"}}}, "then": {"required": ["label", "value"]}},
        {"if": {"properties": {"type": {"const": "flows"}}}, "then": {"required": ["items"], "properties": {
          "items": {"type": "array", "maxItems": 4, "items": {"type": "object", "required": ["name", "value"], "properties": {
            "name": {"type": "string"}, "value": {"type": "number"}, "companies": {"type": "array", "items": {"type": "string"}, "maxItems": 4}}}},
          "other": {"type": "number"}, "prefix": {"type": "string"}, "suffix": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "table"}}}, "then": {"required": ["columns", "rows"], "properties": {
          "columns": {"type": "array", "items": {"type": "object", "required": ["label"], "properties": {"label": {"type": "string"}, "type": {"enum": ["company", "pct"]}}}},
          "rows": {"type": "array", "items": {"type": "array"}}}}},
        {"if": {"properties": {"type": {"const": "notes"}}}, "then": {"required": ["items"], "properties": {"items": {"type": "array", "items": {"type": "string"}}}}},
        {"if": {"properties": {"type": {"const": "html"}}}, "then": {"required": ["html"], "properties": {"html": {"type": "string"}}}}
      ]
    }
  }
}
