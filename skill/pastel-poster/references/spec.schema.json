{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wenjinliuu/poster-kit/skill/pastel-poster/references/spec.schema.json",
  "title": "pastel-poster spec",
  "description": "海报 spec.json 的结构。字段含义见 sections.md；更细的检查（引用的公司是否登记、标题字数等）由 scripts/validate_spec.py 做。",
  "type": "object",
  "required": [
    "title",
    "sections",
    "footer"
  ],
  "properties": {
    "file": {
      "type": "string",
      "description": "下载文件名前缀"
    },
    "eyebrow": {
      "type": "string",
      "description": "标题上方小字"
    },
    "tag": {
      "type": "string",
      "description": "眉题旁的描边小标签"
    },
    "title": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 3,
      "description": "[黑色主句, 强调色大字, 灰色副句]"
    },
    "object": {
      "description": "右上角背景物件：预设名，或 {parts:[[\"box\",x,y,z,w,d,h,色调],[\"cyl\",x,y,z,r,h,色调]]}",
      "oneOf": [
        {
          "enum": [
            "battery",
            "building",
            "chip",
            "coin",
            "db",
            "globe",
            "module",
            "rack",
            "robot",
            "wafer"
          ]
        },
        {
          "type": "object",
          "required": [
            "parts"
          ],
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "强调色，默认靛紫 #5b4cff"
    },
    "updown": {
      "enum": [
        "cn",
        "us"
      ],
      "description": "cn 红涨绿跌（默认），us 绿涨红跌"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "companies": {
      "type": "object",
      "description": "键写 交易所:代码、Yahoo 后缀代码或 市场:代码",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "logo 描边色，不写则自动从 logo 取"
          }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "footer": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "page_title": {
      "type": "string"
    },
    "page_sub": {
      "type": "string"
    },
    "mark": {
      "type": "string"
    },
    "mark_sub": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "description": "品牌头部，见 logos.md",
      "properties": {
        "company": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sub": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "svg": {
          "type": "string"
        },
        "height": {
          "type": "number"
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "wordmark": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "italic": {
                "type": "boolean"
              },
              "font": {
                "enum": [
                  "title"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "badge_ring": {
      "enum": [
        "brand",
        "category",
        "accent",
        "none"
      ],
      "description": "圆形 logo 描边颜色"
    },
    "numbered": {
      "type": "boolean",
      "description": "卡片标题前加编号"
    }
  },
  "$defs": {
    "label": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "sub": {
              "type": "string"
            }
          },
          "required": [
            "label"
          ]
        }
      ]
    },
    "section": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "banner",
            "bars",
            "beat",
            "callout",
            "cards",
            "chain",
            "chips",
            "columns",
            "compare",
            "cycle",
            "deviation",
            "donut",
            "draw",
            "dumbbell",
            "flows",
            "funnel",
            "group",
            "heatmap",
            "holdings",
            "html",
            "kpis",
            "line",
            "mix",
            "notes",
            "points",
            "price",
            "pyramid",
            "quadrant",
            "radar",
            "ranking",
            "rings",
            "row",
            "sankey",
            "scatter",
            "slope",
            "sparks",
            "stackbar",
            "steps",
            "table",
            "target",
            "text",
            "timeline",
            "tree",
            "treemap",
            "waffle",
            "waterfall",
            "years"
          ]
        },
        "title": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "card": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "chain"
              }
            }
          },
          "then": {
            "required": [
              "groups"
            ],
            "properties": {
              "cols": {
                "type": "integer",
                "minimum": 2,
                "maximum": 6
              },
              "groups": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "companies"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "desc": {
                      "type": "string"
                    },
                    "icon": {
                      "type": "string"
                    },
                    "companies": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "kpis"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "value"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "tone": {
                      "enum": [
                        "up",
                        "down",
                        "accent",
                        "ink"
                      ]
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array"
                      }
                    },
                    "icon": {
                      "type": "string"
                    },
                    "company": {
                      "type": "string"
                    }
                  }
                }
              },
              "layout": {
                "enum": [
                  "list"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "holdings"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "other": {
                "type": "number"
              },
              "center_label": {
                "type": "string"
              },
              "center_value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "years"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "highlight_last": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ranking"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "$ref": "#/$defs/label"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "unit": {
                "type": "string"
              },
              "other": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "banner"
              }
            }
          },
          "then": {
            "required": [
              "label",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "flows"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "companies": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 4
                    }
                  }
                }
              },
              "other": {
                "type": "number"
              },
              "prefix": {
                "type": "string"
              },
              "suffix": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "columns",
              "rows"
            ],
            "properties": {
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "company",
                        "pct"
                      ]
                    }
                  }
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "notes"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "html"
              }
            }
          },
          "then": {
            "required": [
              "html"
            ],
            "properties": {
              "html": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "beat"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "waterfall"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mix"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bars"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "line"
              }
            }
          },
          "then": {
            "required": [
              "series"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "columns"
              }
            }
          },
          "then": {
            "required": [
              "x",
              "series"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "points"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "callout"
              }
            }
          },
          "then": {
            "required": [
              "title"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cards"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heatmap"
              }
            }
          },
          "then": {
            "required": [
              "columns",
              "rows"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "deviation"
              }
            }
          },
          "then": {
            "required": [
              "rows"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chips"
              }
            }
          },
          "then": {
            "required": [
              "groups"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "target"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "sections"
            ],
            "properties": {
              "sections": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/section"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "row"
              }
            }
          },
          "then": {
            "required": [
              "sections"
            ],
            "properties": {
              "sections": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/section"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "donut"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stackbar"
              }
            }
          },
          "then": {
            "required": [
              "series",
              "rows"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scatter"
              }
            }
          },
          "then": {
            "required": [
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slope"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dumbbell"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "treemap"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "funnel"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "radar"
              }
            }
          },
          "then": {
            "required": [
              "axes",
              "series"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rings"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "waffle"
              }
            }
          },
          "then": {
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sankey"
              }
            }
          },
          "then": {
            "required": [
              "links"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sparks"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "timeline"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "steps"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "compare"
              }
            }
          },
          "then": {
            "required": [
              "left",
              "right"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "quadrant"
              }
            }
          },
          "then": {
            "required": [
              "cells"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tree"
              }
            }
          },
          "then": {
            "required": [
              "root"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pyramid"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cycle"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "draw"
              }
            }
          },
          "then": {
            "required": [
              "js"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "price"
              }
            }
          },
          "then": {
            "properties": {
              "range": {
                "enum": [
                  "1mo",
                  "3mo",
                  "6mo",
                  "1y",
                  "2y",
                  "5y",
                  "ytd",
                  "max"
                ]
              },
              "style": {
                "enum": [
                  "line",
                  "candle"
                ]
              },
              "ma": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "date",
                    "label"
                  ]
                }
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "tp"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
